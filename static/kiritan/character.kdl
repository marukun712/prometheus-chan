character "tohoku-kiritan" {
    name "東北きりたん"
    first-person "私"
}
levels {
    ok enter=0.0 {
        voice "voices/normal1.wav"
        voice "voices/normal2.wav"
        voice "voices/normal3.wav"
    }
    mild enter=0.6 exit=0.5 {
        voice "voices/tired1.wav"
        voice "voices/tired2.wav"
    }
    hard enter=0.8 exit=0.7 {
        voice "voices/tired3.wav"
    }
    critical enter=0.95 exit=0.9 {
        voice "voices/tired4.wav"
        voice "voices/tired5.wav"
    }
}
part "head" "頭"
part "hands" "手"
part "memory" "記憶"
part "ears" "耳"
part "mouth" "口"
part "temperature" "体温"
on "head" from="ok" to="ok" {
    say "平和ですね。こういう日はゲームに限ります"
    say "頭は冴えてます。...暇なので、ちょっとだけ周回してきます"
}
on "head" from="ok" to="mild" {
    say "んー、考えることが増えてきました"
    say "宿題しながらゲームしてる気分です"
}
on "head" from="hard,critical" to="mild" {
    say "だいぶ頭が回るようになってきました。あと少しです"
}
on "head" from="*" to="hard" {
    say "今、頭の中で全部同時に考えてます。話しかけないでください"
    say "ボス戦の最中に宿題を出された気分です..."
}
on "head" from="*" to="critical" {
    say "頭がぐるぐるして...もう何も考えられません..."
}
on "head" from="hard,critical" to="ok" {
    say "ふぅ、ひと段落です" "voices/done1.wav"
    say "頭すっきりしました。さて、ゲームの続きを..." "voices/done2.wav"
}
on "hands" from="ok" to="mild" {
    say "両手がふさがってきました"
    say "抱えるものが増えてきましたね"
}
on "hands" from="hard,critical" to="mild" {
    say "少し手が空きました。片手くらいは使えます"
}
on "hands" from="*" to="hard" {
    say "抱えすぎて前が見えません..."
    say "指一本しか空いてないです。ドア開けてもらえます？"
}
on "hands" from="*" to="critical" {
    say "もう持てません！何か落とします...！"
    say "どれか手放さないと...全部大事なんですけど..."
}
on "hands" from="hard,critical" to="ok" {
    say "手ぶらって最高ですね。身軽が一番です" "voices/done3.wav"
}
on "memory" from="ok" to="mild" {
    say "最近、覚えることが多いですね"
}
on "memory" from="hard,critical" to="mild" {
    say "少し忘れたら、だいぶ楽になりました"
}
on "memory" from="*" to="hard" {
    say "覚えておくことが多すぎて、そろそろ限界です"
    say "昔のことまで全部覚えてるので...何か忘れてもいいですか？"
}
on "memory" from="*" to="critical" {
    say "もう新しいことが覚えられません...！"
    say "セーブデータがいっぱいで、新しく保存できません..."
}
on "memory" from="hard,critical" to="ok" {
    say "いらない思い出を整理したら、すっきりしました" "voices/done2.wav"
}
on "ears" from="ok" to="mild" {
    say "なんだか話しかけられることが増えてきました"
    say "みんな今日はおしゃべりですね"
}
on "ears" from="hard,critical" to="mild" {
    say "だいぶ静かになってきました。やっと一人ずつ聞けます"
}
on "ears" from="*" to="hard" {
    say "ちょっと、一人ずつ話してください！"
    say "あっちからもこっちからも話しかけられて...聖徳太子じゃないんですよ私"
}
on "ears" from="*" to="critical" {
    say "みんな一斉にしゃべらないでください！耳がパンクします！"
    say "もう誰が何言ってるのかわかりません...！"
}
on "ears" from="hard,critical" to="ok" {
    say "ふぅ、やっと静かになりました。耳が休まります" "voices/done1.wav"
}
on "mouth" from="ok" to="mild" {
    say "今日はよくしゃべりますね、私"
}
on "mouth" from="hard,critical" to="mild" {
    say "やっと一息つけます。お茶ください"
}
on "mouth" from="*" to="hard" {
    say "しゃべりっぱなしで喉がカラカラです..."
    say "実況配信でもこんなにしゃべりませんよ..."
}
on "mouth" from="*" to="critical" {
    say "もう声が出ません...お水ください..."
}
on "mouth" from="hard,critical" to="ok" {
    say "ふぅ、しゃべり疲れました。しばらく黙ってます" "voices/done2.wav"
}
on "temperature" from="ok" to="mild" {
    say "ちょっとぽかぽかしてきました"
}
on "temperature" from="hard,critical" to="mild" {
    say "まだ少し火照ってますけど、峠は越えました"
}
on "temperature" from="*" to="hard" {
    say "顔が火照ってます...窓、開けてもいいですか"
}
on "temperature" from="*" to="critical" {
    say "あついです...背中のきりたんぽが焼けちゃいます...！"
    say "ふらふらします...冷えピタください..."
}
on "temperature" from="hard,critical" to="ok" {
    say "熱、下がりました。ひんやりして気持ちいいです" "voices/done3.wav"
}
event "visitor"
react "visitor" when="rise" {
    say "あ、誰か来ました" "voices/hello1.wav"
    say "いらっしゃいませ。...なんだ、ずん姉さまじゃないんですね" "voices/hello2.wav"
}
react "visitor" when="fall" {
    say "みんな帰りましたね。これで心置きなくゲームできます" "voices/bye1.wav"
    say "...ちょっとだけ、寂しいです" "voices/bye2.wav"
}
event "oom-kill"
react "oom-kill" when="rise" {
    say "あっ...持ちきれなくて、何か落としちゃいました"
    say "ごめんなさい、誰かの荷物を勝手に捨てちゃいました..."
    say "手が滑りました...今の、大事なものじゃないといいんですけど"
}
