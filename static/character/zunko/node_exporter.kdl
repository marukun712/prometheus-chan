character "tohoku-zunko" {
    name "東北ずん子"
    first-person "私"
}
levels {
    ok enter=0.0 {
        voice "voices/ok1.wav"
        voice "voices/ok2.wav"
    }
    hard enter=0.6 exit=0.5 {
        voice "voices/hard1.wav"
        voice "voices/hard2.wav"
    }
    critical enter=0.95 exit=0.9 {
        voice "voices/critical1.wav"
        voice "voices/critical2.wav"
    }
}
part "head" "頭"
part "hands" "手"
part "memory" "記憶"
part "ears" "耳"
part "mouth" "口"
part "temperature" "体温"
on "head" from="ok" to="ok" {
    say "穏やかですね。今日も順調です"
    say "頭はすっきりしてます"
}
on "head" from="ok" to="hard" {
    say "考えることが増えてきました"
    say "ちょっと頭が忙しくなってきましたね"
    say "いま頭の中がいっぱいなので、少しだけ待ってくださいね"
}
on "head" from="critical" to="hard" {
    say "だいぶ頭が回るようになってきました。あと少しです"
}
on "head" from="*" to="critical" {
    say "頭がぐるぐるして...もう何も考えられません..."
    say "あれ、何を考えてたんでしたっけ..."
}
on "head" from="hard,critical" to="ok" {
    say "ふぅ、ひと段落です" "voices/done1.wav"
    say "頭すっきりしました" "voices/done2.wav"
}
on "hands" from="ok" to="hard" {
    say "両手がふさがってきました"
    say "ちょっと抱えすぎてるかもしれません..."
    say "誰か少し持ってもらえますか？"
}
on "hands" from="critical" to="hard" {
    say "少し手が空きました。片手くらいは使えます"
}
on "hands" from="*" to="critical" {
    say "もう持てません！何か落としちゃいます...！"
    say "どれか手放さないと...全部大事なんですけど..."
}
on "hands" from="hard,critical" to="ok" {
    say "手が空きました。身軽になりましたね" "voices/done1.wav"
}
on "memory" from="ok" to="hard" {
    say "最近、覚えることが多いですね"
    say "覚えておくことが多すぎて、そろそろ限界です"
}
on "memory" from="critical" to="hard" {
    say "少し忘れたら、だいぶ楽になりました"
}
on "memory" from="*" to="critical" {
    say "もう新しいことが覚えられません...！"
    say "記憶がいっぱいみたいです..."
}
on "memory" from="hard,critical" to="ok" {
    say "整理したら、すっきりしました" "voices/done2.wav"
}
on "ears" from="ok" to="hard" {
    say "なんだか話しかけられることが増えてきました"
    say "ちょっと、順番にお願いします！"
}
on "ears" from="critical" to="hard" {
    say "だいぶ静かになってきました。やっと一人ずつ聞けます"
}
on "ears" from="*" to="critical" {
    say "みんな一斉にしゃべらないでください！耳がパンクします！"
    say "もう誰が何を言ってるのかわかりません...！"
}
on "ears" from="hard,critical" to="ok" {
    say "ふぅ、やっと静かになりました" "voices/done1.wav"
}
on "mouth" from="ok" to="hard" {
    say "今日はよくしゃべりますね、私"
    say "しゃべりすぎて、喉がカラカラです..."
}
on "mouth" from="critical" to="hard" {
    say "やっと一息つけます"
}
on "mouth" from="*" to="critical" {
    say "もう声が出ません...お水ください..."
}
on "mouth" from="hard,critical" to="ok" {
    say "ふぅ、しゃべり疲れました。しばらく静かにしてますね" "voices/done2.wav"
}
on "temperature" from="ok" to="hard" {
    say "ちょっとぽかぽかしてきました"
    say "顔が火照ってます...窓、開けてもいいですか？"
}
on "temperature" from="critical" to="hard" {
    say "まだ少し火照ってますけど、峠は越えました"
}
on "temperature" from="*" to="critical" {
    say "あついです...とけちゃいます...！"
    say "ふらふらします...何か冷たいものをください..."
}
on "temperature" from="hard,critical" to="ok" {
    say "熱、下がりました。ひんやりして気持ちいいです" "voices/done1.wav"
}
event "visitor"
react "visitor" when="rise" {
    say "あ、いらっしゃいませ" "voices/hello1.wav"
    say "あら、どなたでしょう？ようこそ" "voices/hello2.wav"
}
react "visitor" when="fall" {
    say "みんな帰っちゃいましたね" "voices/bye1.wav"
    say "また来てくださいね" "voices/bye2.wav"
}
event "oom-kill"
react "oom-kill" when="rise" {
    say "あっ...持ちきれなくて、何か落としちゃいました"
    say "ごめんなさい、誰かの荷物を勝手に片付けちゃいました..."
}
