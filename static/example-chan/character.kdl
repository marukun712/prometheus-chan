character "example-chan" {
    name "{hostname}ちゃん"
    first-person "わたし"
}
levels {
    ok enter=0.0
    mild enter=0.6 exit=0.5
    hard enter=0.8 exit=0.7
    critical enter=0.95 exit=0.9
}
part "head" "頭"
part "hands" "手"
part "ears" "耳"
part "skin" "体温"
part "belly" "お腹"
on "head" from="*" to="mild" {
    say "ちょっと考えごと増えてきた" "voice/head_mild_1.ogg"
    say "忙しくなってきたね" "voice/head_mild_2.ogg"
}
on "head" from="*" to="hard" {
    say "頭フル回転中..." "voice/head_hard_1.ogg"
    say "全力で考えてるよ！" "voice/head_hard_2.ogg"
}
on "head" from="*" to="critical" {
    say "もう考えられない...！" "voice/head_crit_1.ogg"
    say "頭から湯気出そう〜" "voice/head_crit_2.ogg"
}
on "head" from="hard,critical" to="ok" {
    say "ふぅ、ひと段落" "voice/head_ok_1.ogg"
    say "頭すっきりした" "voice/head_ok_2.ogg"
}
on "hands" from="*" to="mild" {
    say "持ち物が増えてきたな" "voice/hands_mild_1.ogg"
}
on "hands" from="*" to="hard" {
    say "両手いっぱい..." "voice/hands_hard_1.ogg"
    say "そろそろ持ちきれないかも" "voice/hands_hard_2.ogg"
}
on "hands" from="*" to="critical" {
    say "もう何も持てない！" "voice/hands_crit_1.ogg"
    say "何か落としちゃいそう...！" "voice/hands_crit_2.ogg"
}
on "hands" from="hard,critical" to="ok" {
    say "手が空いた〜" "voice/hands_ok_1.ogg"
}
on "ears" from="*" to="mild" {
    say "ん？今なんて言った？" "voice/ears_mild_1.ogg"
}
on "ears" from="*" to="hard" {
    say "よく聞こえない..." "voice/ears_hard_1.ogg"
    say "聞き逃しが多いみたい" "voice/ears_hard_2.ogg"
}
on "ears" from="*" to="critical" {
    say "何も聞こえないよ...！" "voice/ears_crit_1.ogg"
}
on "ears" from="hard,critical" to="ok" {
    say "あ、ちゃんと聞こえる" "voice/ears_ok_1.ogg"
}
on "skin" from="*" to="mild" {
    say "ちょっとあったかいね" "voice/skin_mild_1.ogg"
}
on "skin" from="*" to="hard" {
    say "なんか熱っぽい..." "voice/skin_hard_1.ogg"
}
on "skin" from="*" to="critical" {
    say "あつい、あついよ...！" "voice/skin_crit_1.ogg"
    say "このままだと倒れちゃう..." "voice/skin_crit_2.ogg"
}
on "skin" from="hard,critical" to="ok" {
    say "熱、下がったみたい" "voice/skin_ok_1.ogg"
}
on "belly" from="*" to="mild" {
    say "そろそろお腹いっぱいかも" "voice/belly_mild_1.ogg"
}
on "belly" from="*" to="hard" {
    say "これ以上食べられないよ〜" "voice/belly_hard_1.ogg"
}
on "belly" from="*" to="critical" {
    say "お腹痛くなってきた" "voice/belly_crit_1.ogg"
}
on "belly" from="hard,critical" to="ok" {
    say "お腹空いてきた..." "voice/belly_ok_1.ogg"
}
