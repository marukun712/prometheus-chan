character "default" {
    name "デフォルト"
    psd "images/character_props.psd"
}
face "default" "tired" "wink" "sad" "angry"
group "face" {
    layer "face"
}
group "hair" {
    layer "front_hair" "back_hair"
}
group "eyes" {
    layer "iris_R" "iris_L"
}
group "brow-l" {
    layer "eyebrow_L"
}
group "brow-r" {
    layer "eyebrow_R"
}
group "mouth" {
    layer "mouth"
}
group "eyewear" {
    layer "glasses"
}
group "list" {
    layer "list"
}
group "mail" {
    layer "mail"
}
move "breathe" loop=true {
    group "body" {
        pose lerp="neutral,shiftY" t=0.1 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.5 ease="t^2 * (3 - 2*t)"
    }
    group "face" {
        pose lerp="neutral,bendY" t=0.4 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.5 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="neutral,swing" t=0.08 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=-0.08 duration=1.5 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="neutral,shiftX" t=0.15 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=0.15 duration=1.2
        pose lerp="neutral,shiftX" t=-0.15 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=-0.15 duration=1.2
    }
    group "brow-l" {
        pose lerp="neutral,shiftY" t="0.2 * tension" duration=1.5
    }
    group "brow-r" {
        pose lerp="neutral,shiftY" t="0.2 * tension" duration=1.5
    }
    group "mouth" {
        pose lerp="neutral,shiftY" t="0.2 * tension" duration=1.5
    }
    group "eyewear" {
        pose lerp="neutral,shiftY" t=0.08 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.5 ease="t^2 * (3 - 2*t)"
    }
    group "list" {
        pose lerp="neutral,tilt" t="2 * load" duration="1 / (1 + load)"
        pose lerp="neutral,tilt" t="-2 * load" duration="1 / (1 + load)"
    }
    group "mail" {
        pose lerp="neutral,shiftX" t="-15 * flow_out" duration="1 / (1 + flow_out)" ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t="15 * flow_in" duration="1 / (1 + flow_in)" ease="1 - (1-t)^3"
    }
}
move "wobble" loop=true {
    group "body" {
        pose lerp="neutral,shiftX" t=0.2 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftX" t=-0.2 duration=0.9 ease="t^2 * (3 - 2*t)"
    }
    group "face" {
        pose lerp="neutral,tilt" t=0.04 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,tilt" t=-0.04 duration=0.9 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="neutral,swing" t=0.09 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=-0.09 duration=0.9 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="neutral,shiftX" t=0.2 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=0.2 duration=0.9
        pose lerp="neutral,shiftX" t=-0.2 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=-0.2 duration=0.9
    }
    group "brow-l" {
        pose lerp="neutral,shiftY" t=0.24 duration=0.9
    }
    group "brow-r" {
        pose lerp="neutral,shiftY" t=0.24 duration=0.9
    }
    group "mouth" {
        pose lerp="neutral,shiftY" t=0.18 duration=0.9
    }
    group "eyewear" {
        pose lerp="neutral,shiftY" t=0.14 duration=1.8 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.04 duration=1.8 ease="t^2 * (3 - 2*t)"
    }
    group "list" {
        pose lerp="neutral,tilt" t="2 * load" duration="1 / (1 + load)"
        pose lerp="neutral,tilt" t="-2 * load" duration="1 / (1 + load)"
    }
    group "mail" {
        pose lerp="neutral,shiftX" t="-15 * flow_out" duration="1 / (1 + flow_out)" ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t="15 * flow_in" duration="1 / (1 + flow_in)" ease="1 - (1-t)^3"
    }
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        face "default"
        move "breathe"
        voice "voices/おつかれさまです.wav"
    }
    hard enter=0.6 exit=0.5 {
        label "すこし疲れています"
        color "#c88a2e"
        face "angry"
        move "breathe"
        voice "voices/……つっついても何も出ませんよ。.wav"
    }
    critical enter=0.95 exit=0.9 {
        label "もう限界です"
        color "#c2453c"
        face "tired"
        move "wobble"
        voice "voices/だめです.wav"
    }
}
