character "default" {
    name "デフォルト"
    psd "images/character.psd"
}
face "default" "tired" "wink" "sad" "angry"
group "face" {
    layer "face"
}
group "hair" {
    layer "front_hair" "back_hair"
}
group "eyes" {
    layer "iris_R" "iris_L"
}
group "brow-l" {
    layer "eyebrow_L"
}
group "brow-r" {
    layer "eyebrow_R"
}
group "mouth" {
    layer "mouth"
}
group "eyewear" {
    layer "glasses"
}
move "breathe" loop=true face="default" {
    group "face" {
        pose lerp="neutral,bendY" t=0.18 duration=2.0 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.8 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="neutral,swing" t=0.08 duration=2.0 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=-0.06 duration=1.8 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="neutral,shiftX" t=0.15 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=0.15 duration=1.65
        pose lerp="neutral,shiftX" t=-0.15 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=-0.15 duration=1.65
    }
    group "brow-l" {
        pose lerp="neutral,shiftY" t=-0.08 duration=2.0 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.8 ease="t^2 * (3 - 2*t)"
    }
    group "brow-r" {
        pose lerp="neutral,shiftY" t=-0.08 duration=2.0 ease="t^2 * (3 - 2*t)"
        pose "neutral" duration=1.8 ease="t^2 * (3 - 2*t)"
    }
}
move "breathe-hard" loop=true face="tired" {
    group "body" {
        pose lerp="neutral,shiftY" t=0.12 duration=0.8 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.03 duration=0.7 ease="t^3"
        pose lerp="neutral,shiftY" t=0.14 duration=0.7 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.04 duration=0.9 ease="t^3"
    }
    group "face" {
        pose lerp="neutral,bendY" t=0.55 duration=0.8 ease="1 - (1-t)^3"
        pose lerp="neutral,bendY" t=0.12 duration=0.7 ease="t^3"
        pose lerp="neutral,bendY" t=0.6 duration=0.7 ease="1 - (1-t)^3"
        pose lerp="neutral,bendY" t=0.15 duration=0.9 ease="t^3"
    }
    group "hair" {
        pose lerp="neutral,swing" t=0.1 duration=0.8 ease="1 - (1-t)^3"
        pose lerp="neutral,swing" t=-0.08 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=0.09 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=-0.07 duration=0.9 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="neutral,shiftY" t=0.18 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.18 duration=1.25
        pose lerp="neutral,shiftX" t=-0.18 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=-0.18 duration=1.25
    }
    group "brow-l" {
        pose lerp="neutral,shiftY" t=0.16 duration=0.8 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.1 duration=0.7 ease="t^3"
        pose lerp="neutral,shiftY" t=0.2 duration=0.7 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.1 duration=0.9 ease="t^3"
    }
    group "brow-r" {
        pose lerp="neutral,shiftY" t=0.16 duration=0.8 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.1 duration=0.7 ease="t^3"
        pose lerp="neutral,shiftY" t=0.2 duration=0.7 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.1 duration=0.9 ease="t^3"
    }
    group "mouth" {
        pose lerp="neutral,shiftY" t=0.2 duration=0.8 ease="1 - (1-t)^3"
        pose "neutral" duration=0.7 ease="t^3"
        pose lerp="neutral,shiftY" t=0.24 duration=0.7 ease="1 - (1-t)^3"
        pose "neutral" duration=0.9 ease="t^3"
    }
    group "eyewear" {
        pose lerp="neutral,shiftY" t=0.08 duration=1.55 ease="t^3"
        pose "neutral" duration=1.55 ease="1 - (1-t)^3"
    }
}
move "wobble" loop=true face="angry" {
    group "body" {
        pose lerp="neutral,shiftX" t=0.22 duration=0.8 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftX" t=-0.18 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.2 duration=0.6 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=0.12 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftX" t=-0.1 duration=0.8 ease="t^2 * (3 - 2*t)"
    }
    group "face" {
        pose lerp="neutral,tilt" t=0.04 duration=0.8 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,tilt" t=-0.035 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,bendY" t=0.3 duration=0.6 ease="1 - (1-t)^3"
        pose lerp="neutral,bendX" t=0.25 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,bendX" t=-0.2 duration=0.8 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="neutral,swing" t=-0.09 duration=0.8 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=0.08 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=0.04 duration=0.6 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="neutral,swing" t=-0.07 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,swing" t=0.06 duration=0.8 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="neutral,shiftX" t=0.2 duration=0.4 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftX" t=0.2 duration=1.0
        pose lerp="neutral,shiftY" t=0.18 duration=0.4 ease="1 - (1-t)^3"
        pose lerp="neutral,shiftY" t=0.18 duration=1.0
        pose lerp="neutral,shiftX" t=-0.2 duration=1.0 ease="t^2 * (3 - 2*t)"
    }
    group "brow-l" {
        pose lerp="neutral,shiftY" t=0.2 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.14 duration=1.0 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.24 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.14 duration=1.0 ease="t^2 * (3 - 2*t)"
    }
    group "brow-r" {
        pose lerp="neutral,shiftY" t=0.2 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.14 duration=1.0 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.24 duration=0.9 ease="t^2 * (3 - 2*t)"
        pose lerp="neutral,shiftY" t=0.14 duration=1.0 ease="t^2 * (3 - 2*t)"
    }
    group "mouth" {
        pose lerp="neutral,shiftY" t=0.18 duration=1.9 ease="t^3"
        pose lerp="neutral,shiftY" t=0.08 duration=1.9 ease="1 - (1-t)^3"
    }
    group "eyewear" {
        pose lerp="neutral,shiftY" t=0.14 duration=1.9 ease="t^3"
        pose lerp="neutral,shiftY" t=0.04 duration=1.9 ease="1 - (1-t)^3"
    }
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        move "breathe"
        voice "voices/おつかれさまです.wav"
    }
    hard enter=0.6 exit=0.5 {
        label "すこし疲れています"
        color "#c88a2e"
        move "breathe-hard"
        voice "voices/……つっついても何も出ませんよ。.wav"
    }
    critical enter=0.95 exit=0.9 {
        label "もう限界です"
        color "#c2453c"
        move "wobble"
        voice "voices/だめです.wav"
    }
}
