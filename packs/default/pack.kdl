character "default" {
    name "デフォルト"
    psd "images/seethrough.psd"
}
group "hair" {
    layer "front hair" "back hair"
}
move "nod" {
    group "hair" {
        pose lerp="up,down" t=0 duration=0.3
        pose lerp="up,down" t=0.5 duration=0.3
    }
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
    }
    hard enter=0.6 exit=0.5 {
        label "すこし疲れています"
        color "#c88a2e"
    }
    critical enter=0.95 exit=0.9 {
        label "もう限界です"
        color "#c2453c"
    }
}
