character "default" {
    name "デフォルト"
    psd "images/character.psd"
}
face "default" "tired" "wink" "sad" "angry"
group "hair" {
    layer "front_hair" "back_hair"
}
group "eyes" {
    layer "iris_L" "iris_R"
}
group "brow-l" {
    layer "eyebrow_L"
}
group "brow-r" {
    layer "eyebrow_R"
}
group "mouth" {
    layer "mouth"
}
group "eyewear" {
    layer "glasses"
}
move "breathe" loop=true face="default" {
    group "body" {
        pose lerp="default,headUp" t=0.13 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose lerp="default,headDown" t=0.09 duration=1.3 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="default,swingLeft" t=0.1 duration=1.5 ease="t^2 * (3 - 2*t)"
        pose lerp="default,swingRight" t=0.1 duration=1.3 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="default,shiftLeft" t=0.3 duration=0.18 ease="1 - (1-t)^3"
        pose lerp="default,shiftLeft" t=0.33 duration=1.22
        pose lerp="default,shiftRight" t=0.3 duration=0.18 ease="1 - (1-t)^3"
        pose lerp="default,shiftRight" t=0.33 duration=1.22
    }
}
move "sway" loop=true face="default" {
    group "body" {
        pose lerp="default,headDown" t=0.22 duration=0.8 ease="t^3"
        pose lerp="default,headUp" t=0.1 duration=0.5 ease="1 - (1-t)^3"
        pose lerp="default,headLeft" t=0.2 duration=0.5 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,headUp" t=0.05 duration=0.6 ease="t^2 * (3 - 2*t)"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.1 duration=0.8 ease="t^3"
        pose lerp="default,swingLeft" t=0.06 duration=0.5 ease="1 - (1-t)^3"
        pose lerp="default,swingRight" t=0.22 duration=0.5 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,swingLeft" t=0.08 duration=0.6 ease="t^2 * (3 - 2*t)"
    }
    group "eyes" {
        pose lerp="default,shiftDown" t=0.38 duration=0.2 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.4 duration=0.8
        pose lerp="default,shiftLeft" t=0.32 duration=0.15 ease="1 - (1-t)^3"
        pose lerp="default,shiftLeft" t=0.34 duration=0.6
        pose lerp="default,shiftDown" t=0.25 duration=0.15 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.28 duration=0.5
    }
    group "brow-l" {
        pose lerp="default,rollRightDown" t=0.52 duration=0.8 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,rollRightDown" t=0.36 duration=0.8 ease="t^2 * (3 - 2*t)"
        pose lerp="default,rollRightDown" t=0.48 duration=0.8 ease="t^2 * (3 - 2*t)"
    }
    group "brow-r" {
        pose lerp="default,rollLeftDown" t=0.52 duration=0.8 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,rollLeftDown" t=0.36 duration=0.8 ease="t^2 * (3 - 2*t)"
        pose lerp="default,rollLeftDown" t=0.48 duration=0.8 ease="t^2 * (3 - 2*t)"
    }
}
move "sink" loop=true face="tired" {
    group "body" {
        pose lerp="default,headDown" t=0.46 duration=0.3 ease="t^3"
        pose lerp="default,headDown" t=0.26 duration=0.2 ease="1 - (1-t)^3"
        pose lerp="default,headDown" t=0.56 duration=0.25 ease="t^3"
        pose lerp="default,headDown" t=0.2 duration=0.45 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "hair" {
        pose lerp="default,swingLeft" t=0.16 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,swingRight" t=0.16 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,swingLeft" t=0.14 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,swingRight" t=0.14 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
    }
    group "eyes" {
        pose lerp="default,shiftLeft" t=0.42 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftLeft" t=0.45 duration=0.18
        pose lerp="default,shiftRight" t=0.38 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftRight" t=0.4 duration=0.18
        pose lerp="default,shiftDown" t=0.5 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.52 duration=0.18
        pose lerp="default,shiftRight" t=0.22 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftRight" t=0.25 duration=0.18
    }
    group "brow-l" {
        pose lerp="default,rollRightDown" t=0.82 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,rollRightDown" t=0.55 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="default,rollRightDown" t=0.85 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,rollRightDown" t=0.6 duration=0.3 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,rollLeftDown" t=0.82 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,rollLeftDown" t=0.55 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="default,rollLeftDown" t=0.85 duration=0.3 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,rollLeftDown" t=0.6 duration=0.3 ease="1 - (1-t)^3"
    }
    group "mouth" {
        pose lerp="default,shiftDown" t=0.5 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="default,shiftUp" t=0.08 duration=0.3 ease="t^3"
        pose lerp="default,shiftDown" t=0.42 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="default,shiftUp" t=0.05 duration=0.4 ease="t^3"
    }
    group "eyewear" {
        pose lerp="default,shiftDown" t=0.62 duration=0.35 ease="t^3"
        pose lerp="default,shiftDown" t=0.3 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.7 duration=0.3 ease="t^3"
        pose lerp="default,shiftDown" t=0.35 duration=0.3 ease="1 - (1-t)^3"
    }
}
move "nod" face="default" {
    group "body" {
        pose lerp="default,headDown" t=0.32 duration=0.32 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.48 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.14 duration=0.32 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.48 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "eyes" {
        pose lerp="default,shiftDown" t=0.38 duration=0.32 ease="1 - (1-t)^3"
        pose "default" duration=0.48 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,shiftUp" t=0.45 duration=0.2 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose "default" duration=0.6 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,shiftUp" t=0.45 duration=0.2 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose "default" duration=0.6 ease="1 - (1-t)^3"
    }
}
move "shake" face="angry" {
    group "body" {
        pose lerp="default,headLeft" t=0.28 duration=0.17 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,headRight" t=0.24 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,headLeft" t=0.16 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,headRight" t=0.09 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.17 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.08 duration=0.17 ease="t^3"
        pose lerp="default,swingLeft" t=0.2 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,swingRight" t=0.17 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,swingLeft" t=0.1 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.17 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "eyes" {
        pose lerp="default,shiftRight" t=0.35 duration=0.17 ease="1 - (1-t)^3"
        pose lerp="default,shiftLeft" t=0.32 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,shiftRight" t=0.2 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose lerp="default,shiftLeft" t=0.1 duration=0.17 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.17 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,rollRightDown" t=0.55 duration=0.25 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,rollRightDown" t=0.4 duration=0.35 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.25 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,rollLeftDown" t=0.55 duration=0.25 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,rollLeftDown" t=0.4 duration=0.35 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.25 ease="1 - (1-t)^3"
    }
}
move "tilt" face="tired" {
    group "body" {
        pose lerp="default,headRight" t=0.32 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,headRight" t=0.28 duration=0.6 ease="1 - (1-t)^3 * cos(t*14)"
        pose "default" duration=0.4 ease="1 - (1-t)^3"
    }
    group "hair" {
        pose lerp="default,swingLeft" t=0.2 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,swingLeft" t=0.14 duration=0.6 ease="1 - (1-t)^3 * cos(t*14)"
        pose "default" duration=0.4 ease="1 - (1-t)^3"
    }
    group "eyes" {
        pose lerp="default,shiftUp" t=0.32 duration=0.25 ease="1 - (1-t)^3"
        pose lerp="default,shiftUp" t=0.34 duration=0.35
        pose lerp="default,shiftRight" t=0.3 duration=0.2 ease="1 - (1-t)^3"
        pose lerp="default,shiftRight" t=0.32 duration=0.2
        pose "default" duration=0.4 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,shiftUp" t=0.5 duration=0.3 ease="1 + 4.5*(t-1)^3 + 3.5*(t-1)^2"
        pose lerp="default,shiftUp" t=0.44 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.4 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,rollLeftDown" t=0.38 duration=0.3 ease="1 - (1-t)^3"
        pose lerp="default,rollLeftDown" t=0.32 duration=0.7 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.4 ease="1 - (1-t)^3"
    }
}
move "lift" face="wink" {
    group "body" {
        pose lerp="default,headUp" t=0.36 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.5 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.16 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.5 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "eyes" {
        pose lerp="default,shiftUp" t=0.3 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,shiftUp" t=0.6 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.5 ease="1 - (1-t)^3 * cos(t*14)"
    }
    group "brow-r" {
        pose lerp="default,shiftUp" t=0.6 duration=0.4 ease="4.5*t^3 - 3.5*t^2"
        pose "default" duration=0.5 ease="1 - (1-t)^3 * cos(t*14)"
    }
}
move "drop" face="sad" {
    group "body" {
        pose lerp="default,headDown" t=0.46 duration=0.42 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,headDown" t=0.4 duration=0.88 ease="1 - (1-t)^3 * cos(t*14)"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.2 duration=0.42 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,swingRight" t=0.12 duration=0.88 ease="1 - (1-t)^3 * cos(t*14)"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "eyes" {
        pose lerp="default,shiftDown" t=0.52 duration=0.42 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.48 duration=0.88
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,rollRightDown" t=0.68 duration=0.42 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,rollRightDown" t=0.55 duration=0.88 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,rollLeftDown" t=0.68 duration=0.42 ease="4.5*t^3 - 3.5*t^2"
        pose lerp="default,rollLeftDown" t=0.55 duration=0.88 ease="t^2 * (3 - 2*t)"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
    group "eyewear" {
        pose lerp="default,shiftDown" t=0.45 duration=0.42 ease="t^3"
        pose lerp="default,shiftDown" t=0.38 duration=0.88 ease="1 - (1-t)^3 * cos(t*14)"
        pose "default" duration=0.5 ease="1 - (1-t)^3"
    }
}
move "jump" face="angry" {
    group "body" {
        pose lerp="default,headUp" t=0.34 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,headRight" t=0.16 duration=0.2 ease="1 - (1-t)^3 * cos(t*14)"
        pose lerp="default,headDown" t=0.16 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
    group "hair" {
        pose lerp="default,swingRight" t=0.22 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,swingLeft" t=0.14 duration=0.2 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,swingRight" t=0.08 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
    group "eyes" {
        pose lerp="default,shiftUp" t=0.45 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftRight" t=0.32 duration=0.2 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.26 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
    group "brow-l" {
        pose lerp="default,shiftUp" t=0.7 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftUp" t=0.4 duration=0.2 ease="1 - (1-t)^3 * cos(t*14)"
        pose lerp="default,rollRightDown" t=0.48 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
    group "brow-r" {
        pose lerp="default,shiftUp" t=0.7 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftUp" t=0.4 duration=0.2 ease="1 - (1-t)^3 * cos(t*14)"
        pose lerp="default,rollLeftDown" t=0.48 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
    group "eyewear" {
        pose lerp="default,shiftDown" t=0.3 duration=0.12 ease="1 - (1-t)^3"
        pose lerp="default,shiftDown" t=0.22 duration=0.2 ease="1 - (1-t)^2 * cos(t*20)"
        pose lerp="default,shiftDown" t=0.48 duration=0.3 ease="t^3"
        pose "default" duration=0.45 ease="1 - (1-t)^3"
    }
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        move "breathe"
    }
    hard enter=0.6 exit=0.5 {
        label "すこし疲れています"
        color "#c88a2e"
        move "sway"
    }
    critical enter=0.95 exit=0.9 {
        label "もう限界です"
        color "#c2453c"
        move "sink"
    }
}
