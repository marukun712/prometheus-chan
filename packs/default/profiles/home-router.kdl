part "wan-rx" "外から届く郵便" {
    on from="*" to="hard" {
        say line="外からの郵便がたくさん届いてます。仕分けしますね" voice="voices/ええっと…….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="外からの郵便があふれてます" voice="voices/無理です.wav" move="shake"
        say line="受け取りきれません" voice="voices/あぁっ！.wav" move="jump"
    }
    on from="hard,critical" to="ok" {
        say line="外からの郵便、落ち着いてきました" voice="voices/よしっ.wav" move="lift"
    }
    ask level="ok" {
        say line="外からの郵便、今は落ち着いてます" voice="voices/はい.wav" move="nod"
    }
    ask level="hard" {
        say line="外からの郵便がたくさんです。仕分けしてますね" voice="voices/ええっと…….wav" move="tilt"
    }
    ask level="critical" {
        say line="受け取りきれないくらい届いてます" voice="voices/無理です.wav" move="drop"
    }
}
part "wan-tx" "外への発送" {
    on from="*" to="hard" {
        say line="外への発送が増えてきました。急いで出してます" voice="voices/もう….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="発送が詰まってます。外への道がいっぱいです" voice="voices/だめです.wav" move="shake"
    }
    on from="hard,critical" to="ok" {
        say line="外への発送、落ち着いてきました" voice="voices/えへへ…….wav" move="lift"
    }
    ask level="ok" {
        say line="外への発送、順調です" voice="voices/よしっ.wav" move="lift"
    }
    ask level="hard" {
        say line="発送が増えてきました。急いで出してます" voice="voices/もう….wav" move="tilt"
    }
    ask level="critical" {
        say line="発送が詰まってます" voice="voices/だめです.wav" move="drop"
    }
}
part "lan-rx" "おうちからの集荷" {
    on from="*" to="hard" {
        say line="おうちから出す郵便、たくさん預かってます" voice="voices/はあ…….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="おうちからの集荷が止まりません。もう抱えきれないです" voice="voices/ううう…….wav" move="drop"
    }
    on from="hard,critical" to="ok" {
        say line="おうちからの集荷、ひと段落しました" voice="voices/よしっ.wav" move="lift"
    }
    ask level="ok" {
        say line="おうちからの集荷、落ち着いてます" voice="voices/えへへ…….wav" move="nod"
    }
    ask level="hard" {
        say line="おうちからの集荷が増えてます" voice="voices/はあ…….wav" move="tilt"
    }
    ask level="critical" {
        say line="おうちからの集荷が止まりません" voice="voices/ううう…….wav" move="drop"
    }
}
part "lan-tx" "おうちへの配達" {
    on from="*" to="hard" {
        say line="おうちへの配達が忙しくなってきました" voice="voices/もう….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="おうちへの配達が追いつきません" voice="voices/ひっ.wav" move="jump"
    }
    on from="hard,critical" to="ok" {
        say line="おうちへの配達、落ち着きました" voice="voices/えへへ…….wav" move="lift"
    }
    ask level="ok" {
        say line="おうちへの配達、順調です" voice="voices/はい.wav" move="nod"
    }
    ask level="hard" {
        say line="おうちへの配達が忙しくなってます" voice="voices/もう….wav" move="tilt"
    }
    ask level="critical" {
        say line="おうちへの配達が追いつきません" voice="voices/ひっ.wav" move="jump"
    }
}
part "head" "頭" {
    on from="*" to="hard" {
        say line="仕分けの判断が追いつかなくなってきました" voice="voices/はあ…….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="仕分けの判断が追いつきません。もう限界です" voice="voices/ううう…….wav" move="drop"
    }
    on from="hard,critical" to="ok" {
        say line="すっきりしました。もう大丈夫ですよ" voice="voices/あはは！.wav" move="lift"
    }
    ask level="ok" {
        say line="いまは余裕があります。このくらい、わたしには簡単です" voice="voices/よしっ.wav" move="lift"
    }
    ask level="hard" {
        say line="仕分けの判断が少し追いつきません" voice="voices/はあ…….wav" move="tilt"
    }
    ask level="critical" {
        say line="頭がいっぱいです。少し待ってください" voice="voices/ごめんなさい.wav" move="drop"
    }
    care level="critical" line="仕分けが追いつきません。荷物を減らしてください。わたしは一人なんですよ"
}
part "desk" "作業台" {
    on from="*" to="hard" {
        say line="作業台が散らかってきました" voice="voices/ちぇっ…….wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="作業台がいっぱいで、もう置けません" voice="voices/最低です！.wav" move="jump"
    }
    on from="hard,critical" to="ok" {
        say line="作業台、片付きました" voice="voices/よしっ.wav" move="lift"
    }
    ask level="ok" {
        say line="作業台はきれいです" voice="voices/はい.wav" move="nod"
    }
    ask level="hard" {
        say line="作業台が散らかってきました" voice="voices/ちぇっ…….wav" move="tilt"
    }
    ask level="critical" {
        say line="作業台がいっぱいで、もう置けません" voice="voices/最低です！.wav" move="jump"
    }
    care level="hard,critical" line="作業台がぐちゃぐちゃです。片付けるの、手伝ってくれませんか"
}
part "temp" "体温" {
    on from="*" to="hard" {
        say line="ちょっと暑くなってきましたね" voice="voices/うー.wav" move="tilt"
    }
    on from="*" to="critical" {
        say line="暑いです。このままだと倒れちゃいそう" voice="voices/ふえ…….wav" move="drop"
    }
    on from="hard,critical" to="ok" {
        say line="涼しくなってきました。生き返ります" voice="voices/えへへ…….wav" move="lift"
    }
    ask level="ok" {
        say line="体温はふつうです" voice="voices/はい.wav" move="nod"
    }
    ask level="hard" {
        say line="ちょっと暑くなってきました" voice="voices/うー.wav" move="tilt"
    }
    ask level="critical" {
        say line="あついです。ふらふらします" voice="voices/ふえ…….wav" move="drop"
    }
    care level="hard,critical" line="暑いです。涼しくしてもらえないと、そのうち倒れますよ"
}
