input "tension" part="head"
part "wan-rx" "外から届く郵便" {
    on from="*" to="hard" {
        say line="外からの郵便がたくさん届いてます。仕分けしますね" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="外からの郵便があふれてます" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="外からの郵便、落ち着いてきました" voice="voices/よしっ.wav"
    }
}
part "wan-tx" "外への発送" {
    on from="*" to="hard" {
        say line="外への発送が増えてきました。急いで出してます" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="発送が詰まってます。外への道がいっぱいです" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="外への発送、落ち着いてきました" voice="voices/よしっ.wav"
    }
}
part "lan-rx" "おうちからの集荷" {
    on from="*" to="hard" {
        say line="おうちから出す郵便、たくさん預かってます" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="おうちからの集荷が止まりません。もう抱えきれないです" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="おうちからの集荷、ひと段落しました" voice="voices/よしっ.wav"
    }
}
part "lan-tx" "おうちへの配達" {
    on from="*" to="hard" {
        say line="おうちへの配達が忙しくなってきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="おうちへの配達が追いつきません" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="おうちへの配達、落ち着きました" voice="voices/よしっ.wav"
    }
}
part "head" "頭" {
    on from="*" to="hard" {
        say line="仕分けの判断が追いつかなくなってきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="仕分けの判断が追いつきません。もう限界です" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="すっきりしました。もう大丈夫ですよ" voice="voices/よしっ.wav"
    }
    care level="critical" line="仕分けが追いつきません。荷物を減らしてください。わたしは一人なんですよ"
}
part "desk" "作業台" {
    on from="*" to="hard" {
        say line="作業台が散らかってきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="作業台がいっぱいで、もう置けません" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="作業台、片付きました" voice="voices/よしっ.wav"
    }
    care level="hard,critical" line="作業台がぐちゃぐちゃです。片付けるの、手伝ってくれませんか"
}
part "temp" "体温" {
    on from="*" to="hard" {
        say line="ちょっと暑くなってきましたね" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="暑いです。このままだと倒れちゃいそう" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="涼しくなってきました。生き返ります" voice="voices/よしっ.wav"
    }
    care level="hard,critical" line="暑いです。涼しくしてもらえないと、そのうち倒れますよ"
}
