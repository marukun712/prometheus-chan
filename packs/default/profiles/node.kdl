part "head" "頭" {
    on from="*" to="hard" {
        say line="考えることが増えてきました。少し忙しいです" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="頭がぐるぐるして、もう何も考えられません" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="頭がすっきりしました。このくらいがちょうどいいんです" voice="voices/よしっ.wav"
    }
    care level="critical" line="考えることが多すぎます。何か止めてください。わたし、そんなに器用じゃないです"
}
part "hands" "手" {
    on from="*" to="hard" {
        say line="両手がふさがってきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="もう持てません。何か落としちゃいます" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="手が空きました。身軽になりましたね" voice="voices/よしっ.wav"
    }
    care level="critical" line="両手がふさがったままです。いつまで持たせるんですか"
}
part "memory" "記憶" {
    on from="*" to="hard" {
        say line="覚えることが多くなってきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="もう新しいことは覚えられません" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="いろいろ忘れられました。すっきりしました" voice="voices/よしっ.wav"
    }
    care level="hard,critical" line="もう何も入りません。いらないものくらい、自分で捨てられませんか"
}
part "ears" "耳" {
    on from="*" to="hard" {
        say line="話しかけられることが増えてきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="みんな一斉にしゃべらないでください。耳がパンクします" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="やっと静かになりました。一人ずつ聞けます" voice="voices/よしっ.wav"
    }
    care level="critical" line="一度にそんなに話しかけられても困ります。少し黙ってもらえませんか"
}
part "mouth" "口" {
    on from="*" to="hard" {
        say line="しゃべりすぎて、喉がカラカラです" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="もう声が出ません。お水ください" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="しゃべり疲れました。しばらく静かにしてますね" voice="voices/よしっ.wav"
    }
    care level="critical" line="しゃべりすぎて声が出ません。もう休ませてください"
}
part "temperature" "体温" {
    on from="*" to="hard" {
        say line="ちょっとぽかぽかしてきました" voice="voices/はあ…….wav"
    }
    on from="*" to="critical" {
        say line="ふらふらします。何か冷たいものをください" voice="voices/疲れました……。今日の会話量、上限オーバーです……。.wav"
    }
    on from="hard,critical" to="ok" {
        say line="ひんやりしてて、落ち着きます" voice="voices/よしっ.wav"
    }
    care level="hard,critical" line="暑くて溶けそうです。風くらい通してもらえませんか"
}
