prometheus url="http://10.0.0.1:9020" interval="10000"
server port=3000
query "wan-rx" "rate(ifHCInOctets{ifDescr=\"GigaEthernet0\"}[5m]) * 8 / (ifHighSpeed{ifDescr=\"GigaEthernet0\"} * 1e6)"
query "wan-tx" "rate(ifHCOutOctets{ifDescr=\"GigaEthernet0\"}[5m]) * 8 / (ifHighSpeed{ifDescr=\"GigaEthernet0\"} * 1e6)"
query "lan-rx" "rate(ifHCInOctets{ifDescr=\"GigaEthernet2\"}[5m]) * 8 / (ifHighSpeed{ifDescr=\"GigaEthernet2\"} * 1e6)"
query "lan-tx" "rate(ifHCOutOctets{ifDescr=\"GigaEthernet2\"}[5m]) * 8 / (ifHighSpeed{ifDescr=\"GigaEthernet2\"} * 1e6)"
query "head" "picoSchedRtUtl1Min / 100"
query "desk" "picoHeapUtil / 100"
query "temp" "picoCelsius / 100"
