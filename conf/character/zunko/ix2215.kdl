character "tohoku-zunko" {
    name "東北ずん子"
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        voice "voices/ok1.wav"
        voice "voices/ok2.wav"
        image "images/normal.png"
    }
    hard enter=0.6 exit=0.5 {
        label "少し疲れている"
        color "#c88a2e"
        voice "voices/hard1.wav"
        voice "voices/hard2.wav"
        image "images/hard.png"
    }
    critical enter=0.95 exit=0.9 {
        label "とても疲れている"
        color "#c2453c"
        voice "voices/critical1.wav"
        voice "voices/critical2.wav"
        image "images/critical.png"
    }
}
part "wan-rx" "外から届く郵便"
part "wan-tx" "外への発送"
part "wan-link" "外への道"
part "home-rx" "おうちからの集荷"
part "home-tx" "おうちへの配達"
part "home-link" "おうちへの道"
part "server-rx" "サーバーさんからの集荷"
part "server-tx" "サーバーさんへの配達"
part "server-link" "サーバーさんへの道"
part "head" "頭"
part "desk" "作業台"
part "temp" "体温"
on "wan-rx" from="*" to="hard" {
    say line="外からの郵便がたくさん届いてます！仕分けがんばりますね"
}
on "wan-rx" from="*" to="critical" {
    say line="受け取りきれません〜！外からの郵便があふれてます...！"
}
on "wan-rx" from="hard,critical" to="ok" {
    say line="外からの郵便、落ち着いてきました" voice="voices/done1.wav"
}
on "wan-tx" from="*" to="hard" {
    say line="外への発送が増えてきました。どんどん出していきますね"
}
on "wan-tx" from="*" to="critical" {
    say line="発送が詰まってます...！外への道がいっぱいです！"
}
on "wan-tx" from="hard,critical" to="ok" {
    say line="外への発送、順調に戻りました" voice="voices/done2.wav"
}
on "wan-link" from="*" to="critical" {
    say line="外への道が通れません！郵便が出せなくなっちゃいました..."
}
on "wan-link" from="critical" to="ok" {
    say line="外への道、また通れるようになりました！" voice="voices/done1.wav"
}
on "home-rx" from="*" to="hard" {
    say line="おうちから出す郵便、たくさん預かってます"
}
on "home-rx" from="*" to="critical" {
    say line="おうちからの集荷が止まりません...！もう抱えきれないです！"
}
on "home-rx" from="hard,critical" to="ok" {
    say line="おうちからの集荷、ひと段落しました" voice="voices/done2.wav"
}
on "home-tx" from="*" to="hard" {
    say line="おうちへの配達、忙しくなってきました"
}
on "home-tx" from="*" to="critical" {
    say line="おうちへの配達が追いつきません〜！"
}
on "home-tx" from="hard,critical" to="ok" {
    say line="おうちへの配達、落ち着きました" voice="voices/done1.wav"
}
on "home-link" from="*" to="critical" {
    say line="おうちに配達に行けません...！道がふさがってるみたいです"
}
on "home-link" from="critical" to="ok" {
    say line="おうちへの道、通れるようになりました。配達再開しますね！" voice="voices/done2.wav"
}
on "server-rx" from="*" to="hard" {
    say line="サーバーさんから発送の依頼がいっぱいです"
}
on "server-rx" from="*" to="critical" {
    say line="サーバーさんからの依頼、さばききれません...！"
}
on "server-rx" from="hard,critical" to="ok" {
    say line="サーバーさんからの依頼、落ち着いてきました" voice="voices/done1.wav"
}
on "server-tx" from="*" to="hard" {
    say line="サーバーさん宛ての郵便が増えてます"
}
on "server-tx" from="*" to="critical" {
    say line="サーバーさんへの配達が滞ってます...！"
}
on "server-tx" from="hard,critical" to="ok" {
    say line="サーバーさんへの配達、順調です" voice="voices/done2.wav"
}
on "server-link" from="*" to="critical" {
    say line="サーバーさんのところに行けなくなりました...どうしましょう"
}
on "server-link" from="critical" to="ok" {
    say line="サーバーさんへの道、復旧しました！" voice="voices/done1.wav"
}
on "head" from="*" to="hard" {
    say line="うーん、仕分けの判断が追いつかなくなってきました..."
}
on "head" from="*" to="critical" {
    say line="頭がいっぱいです！処理が追いつきません...！"
}
on "head" from="hard,critical" to="ok" {
    say line="すっきりしました！もう大丈夫ですよ" voice="voices/done2.wav"
}
on "desk" from="*" to="hard" {
    say line="作業台が散らかってきました..."
}
on "desk" from="*" to="critical" {
    say line="作業台がいっぱいで、もう置けません〜！"
}
on "desk" from="hard,critical" to="ok" {
    say line="作業台、片付きました" voice="voices/done1.wav"
}
on "temp" from="*" to="hard" {
    say line="ちょっと暑くなってきましたね..."
}
on "temp" from="*" to="critical" {
    say line="あ、暑いです...このままだと倒れちゃいそう..."
}
on "temp" from="hard,critical" to="ok" {
    say line="涼しくなってきました。ふう..." voice="voices/done2.wav"
}
event "wan-rx-spike"
event "wan-tx-spike"
react "wan-rx-spike" when="rise" {
    say line="わっ、外から急に郵便がどっさり届きました！" image="images/critical.png"
}
react "wan-tx-spike" when="rise" {
    say line="あれ、外への発送が急に増えてます。何か大きな荷物でしょうか？" image="images/critical.png"
}
