character "tohoku-zunko" {
    name "東北ずん子"
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        voice "voices/ok1.wav"
        voice "voices/ok2.wav"
        image "images/normal.png"
    }
    hard enter=0.6 exit=0.5 {
        label "少し疲れている"
        color "#c88a2e"
        voice "voices/hard1.wav"
        voice "voices/hard2.wav"
        image "images/hard.png"
    }
    critical enter=0.95 exit=0.9 {
        label "とても疲れている"
        color "#c2453c"
        voice "voices/critical1.wav"
        voice "voices/critical2.wav"
        image "images/critical.png"
    }
}
part "head" "頭"
part "hands" "手"
part "memory" "記憶"
part "ears" "耳"
part "mouth" "口"
part "temperature" "体温"
on "head" from="ok" to="ok" {
    say line="穏やかですね。今日も順調です"
    say line="頭はすっきりしてます"
}
on "head" from="ok" to="hard" {
    say line="考えることが増えてきました"
    say line="ちょっと頭が忙しくなってきましたね"
    say line="いま頭の中がいっぱいなので、少しだけ待ってくださいね"
}
on "head" from="critical" to="hard" {
    say line="だいぶ頭が回るようになってきました。あと少しです"
}
on "head" from="*" to="critical" {
    say line="頭がぐるぐるして...もう何も考えられません..."
    say line="あれ、何を考えてたんでしたっけ..."
}
on "head" from="hard,critical" to="ok" {
    say line="ふぅ、ひと段落です" voice="voices/done1.wav"
    say line="頭すっきりしました" voice="voices/done2.wav"
}
on "hands" from="ok" to="hard" {
    say line="両手がふさがってきました"
    say line="ちょっと抱えすぎてるかもしれません..."
    say line="誰か少し持ってもらえますか？"
}
on "hands" from="critical" to="hard" {
    say line="少し手が空きました。片手くらいは使えます"
}
on "hands" from="*" to="critical" {
    say line="もう持てません！何か落としちゃいます...！"
    say line="どれか手放さないと...全部大事なんですけど..."
}
on "hands" from="hard,critical" to="ok" {
    say line="手が空きました。身軽になりましたね" voice="voices/done1.wav"
}
on "memory" from="ok" to="hard" {
    say line="最近、覚えることが多いですね"
    say line="覚えておくことが多すぎて、そろそろ限界です"
}
on "memory" from="critical" to="hard" {
    say line="少し忘れたら、だいぶ楽になりました"
}
on "memory" from="*" to="critical" {
    say line="もう新しいことが覚えられません...！"
    say line="記憶がいっぱいみたいです..."
}
on "memory" from="hard,critical" to="ok" {
    say line="整理したら、すっきりしました" voice="voices/done2.wav"
}
on "ears" from="ok" to="hard" {
    say line="なんだか話しかけられることが増えてきました"
    say line="ちょっと、順番にお願いします！"
}
on "ears" from="critical" to="hard" {
    say line="だいぶ静かになってきました。やっと一人ずつ聞けます"
}
on "ears" from="*" to="critical" {
    say line="みんな一斉にしゃべらないでください！耳がパンクします！"
    say line="もう誰が何を言ってるのかわかりません...！"
}
on "ears" from="hard,critical" to="ok" {
    say line="ふぅ、やっと静かになりました" voice="voices/done1.wav"
}
on "mouth" from="ok" to="hard" {
    say line="今日はよくしゃべりますね、私"
    say line="しゃべりすぎて、喉がカラカラです..."
}
on "mouth" from="critical" to="hard" {
    say line="やっと一息つけます"
}
on "mouth" from="*" to="critical" {
    say line="もう声が出ません...お水ください..."
}
on "mouth" from="hard,critical" to="ok" {
    say line="ふぅ、しゃべり疲れました。しばらく静かにしてますね" voice="voices/done2.wav"
}
on "temperature" from="ok" to="hard" {
    say line="ちょっとぽかぽかしてきました"
    say line="顔が火照ってます...窓、開けてもいいですか？"
}
on "temperature" from="critical" to="hard" {
    say line="まだ少し火照ってますけど、峠は越えました"
}
on "temperature" from="*" to="critical" {
    say line="あついです...とけちゃいます...！"
    say line="ふらふらします...何か冷たいものをください..."
}
on "temperature" from="hard,critical" to="ok" {
    say line="熱、下がりました。ひんやりして気持ちいいです" voice="voices/done1.wav"
}
event "visitor"
react "visitor" when="rise" {
    say line="あ、いらっしゃいませ" voice="voices/hello1.wav"
    say line="あら、どなたでしょう？ようこそ" voice="voices/hello2.wav"
}
react "visitor" when="fall" {
    say line="みんな帰っちゃいましたね" voice="voices/bye1.wav"
    say line="また来てくださいね" voice="voices/bye2.wav"
}
event "oom-kill"
react "oom-kill" when="rise" {
    say line="あっ...持ちきれなくて、何か落としちゃいました"
    say line="ごめんなさい、誰かの荷物を勝手に片付けちゃいました..."
}
