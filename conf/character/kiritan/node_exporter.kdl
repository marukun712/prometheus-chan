character "tohoku-kiritan" {
    name "東北きりたん"
}
levels {
    ok enter=0.0 {
        label "ふつう"
        color "#4a8f6f"
        voice "voices/よしっ.wav"
        voice "voices/えへへ…….wav"
        voice "voices/はい.wav"
        image "images/default.png"
    }
    hard enter=0.6 exit=0.5 {
        label "すこし疲れています"
        color "#c88a2e"
        voice "voices/はあ…….wav"
        voice "voices/もう….wav"
        voice "voices/ぅっ.wav"
        image "images/default.png"
    }
    critical enter=0.95 exit=0.9 {
        label "もう限界です"
        color "#c2453c"
        voice "voices/あー、もう！.wav"
        voice "voices/無理です.wav"
        voice "voices/ううう…….wav"
        image "images/default.png"
    }
}
part "head" "頭"
part "hands" "手"
part "memory" "記憶"
part "ears" "耳"
part "mouth" "口"
part "temperature" "体温"
on "head" from="*" to="hard" {
    say line="考えることが増えてきました。少し忙しいです" voice="voices/はあ…….wav"
    say line="頭のなかが、だいぶ混み合ってきました" voice="voices/ぅっ.wav"
}
on "head" from="*" to="critical" {
    say line="頭がぐるぐるして、もう何も考えられません" voice="voices/無理です.wav"
    say line="考えることが多すぎます。もう限界です" voice="voices/ううう…….wav"
}
on "head" from="hard,critical" to="ok" {
    say line="頭がすっきりしました。このくらいがちょうどいいんです" voice="voices/よしっ.wav"
    say line="ようやく落ち着きました。これなら考えられます" voice="voices/えへへ…….wav"
}
on "hands" from="*" to="hard" {
    say line="両手がふさがってきました" voice="voices/あのですね.wav"
}
on "hands" from="*" to="critical" {
    say line="もう持てません。何か落としちゃいます" voice="voices/あぁっ！.wav"
    say line="これ以上は抱えられません" voice="voices/だめです.wav"
}
on "hands" from="hard,critical" to="ok" {
    say line="手が空きました。身軽になりましたね" voice="voices/やりました！.wav"
}
on "memory" from="*" to="hard" {
    say line="覚えることが多くなってきました" voice="voices/もう….wav"
}
on "memory" from="*" to="critical" {
    say line="もう新しいことは覚えられません" voice="voices/ガーン.wav"
    say line="これ以上は入りません" voice="voices/無理です.wav"
}
on "memory" from="hard,critical" to="ok" {
    say line="いろいろ忘れられました。すっきりしました" voice="voices/えへへ…….wav"
}
on "ears" from="*" to="hard" {
    say line="話しかけられることが増えてきました" voice="voices/ぅっ.wav"
}
on "ears" from="*" to="critical" {
    say line="みんな一斉にしゃべらないでください。耳がパンクします" voice="voices/ばかばか！.wav"
    say line="一度にそんなに話されても、聞き取れません" voice="voices/アホですか！.wav"
}
on "ears" from="hard,critical" to="ok" {
    say line="やっと静かになりました。一人ずつ聞けます" voice="voices/よしっ.wav"
}
on "mouth" from="*" to="hard" {
    say line="しゃべりすぎて、喉がカラカラです" voice="voices/はあ…….wav"
}
on "mouth" from="*" to="critical" {
    say line="もう声が出ません。お水ください" voice="voices/ううう…….wav"
}
on "mouth" from="hard,critical" to="ok" {
    say line="しゃべり疲れました。しばらく静かにしてますね" voice="voices/んっ.wav"
}
on "temperature" from="*" to="hard" {
    say line="ちょっとぽかぽかしてきました" voice="voices/うー.wav"
}
on "temperature" from="*" to="critical" {
    say line="ふらふらします。何か冷たいものをください" voice="voices/あー、もう！.wav"
    say line="あつすぎます。もう限界です" voice="voices/ひっ.wav"
}
on "temperature" from="hard,critical" to="ok" {
    say line="ひんやりしてて、落ち着きます" voice="voices/えへへ…….wav"
}
event "visitor"
react "visitor" when="rise" {
    say line="こんにちは" voice="voices/こんにちは.wav"
    say line="こんばんは" voice="voices/こんばんは.wav"
    say line="おはようございます" voice="voices/おはようございます.wav"
    say line="おかえりなさい" voice="voices/おかえりなさい.wav"
}
react "visitor" when="fall" {
    say line="いってらっしゃい" voice="voices/いってらっしゃい.wav"
    say line="さようなら..." voice="voices/さようなら　寂しい.wav"
    say line="へばな。" voice="voices/へばな。.wav"
}
event "oom-kill"
react "oom-kill" when="rise" {
    say line="持ちきれなくて、何か落としちゃいました" voice="voices/うわぁ…….wav"
    say line="すみません、取り落としました" voice="voices/ぁっ.wav"
}
ask "head" level="ok" {
    say line="いまは余裕があります。なんでも考えられますよ" voice="voices/はい.wav"
}
ask "head" level="hard" {
    say line="考えることが多くて、少し忙しいです" voice="voices/そうです　相槌.wav"
}
ask "head" level="critical" {
    say line="今は頭がいっぱいで...後にしてもらえますか" voice="voices/ごめんなさい.wav"
}
ask "hands" level="ok" {
    say line="両手はまだ空いてます。何か持ちましょうか" voice="voices/やりまーす.wav"
}
ask "hands" level="hard" {
    say line="だいぶ抱えてますけど、まだ平気です" voice="voices/はい.wav"
}
ask "hands" level="critical" {
    say line="手がふさがってて、動けないです" voice="voices/ぅっ.wav"
}
ask "memory" level="ok" {
    say line="まだいろんな物を覚えられます" voice="voices/がんばります！.wav"
}
ask "memory" level="hard" {
    say line="そろそろ覚えきれなくなってきました" voice="voices/はあ…….wav"
}
ask "memory" level="critical" {
    say line="もう何も入りません。整理してほしいです" voice="voices/まったく…….wav"
}
ask "ears" level="ok" {
    say line="今は静かです。ちゃんと聞こえてますよ" voice="voices/そうです　相槌.wav"
}
ask "ears" level="hard" {
    say line="いろんな声が届いてて、ちょっと賑やかです" voice="voices/ううう…….wav"
}
ask "ears" level="critical" {
    say line="耳がいっぱいで、うまく聞き取れません" voice="voices/無理です.wav"
}
ask "mouth" level="ok" {
    say line="喉の調子はいいですよ" voice="voices/よしっ.wav"
}
ask "mouth" level="hard" {
    say line="さっきからよくしゃべってるので、少し喉が疲れました" voice="voices/はあ…….wav"
}
ask "mouth" level="critical" {
    say line="もう声が出なくて..." voice="voices/ごめんなさい.wav"
}
ask "temperature" level="ok" {
    say line="体温はふつうです。ひんやりしてて気持ちいいです" voice="voices/はい.wav"
}
ask "temperature" level="hard" {
    say line="ちょっとぽかぽかしてます" voice="voices/うー.wav"
}
ask "temperature" level="critical" {
    say line="あついです。あまり近づかないほうがいいかもしれません" voice="voices/ふえ…….wav"
}
care "memory" level="hard,critical" {
    line "もう何も入りません。いらないものくらい、自分で捨てられませんか"
}
care "hands" level="critical" {
    line "両手がふさがったままです。いつまで持たせるんですか"
}
care "head" level="critical" {
    line "考えることが多すぎます。何か止めてください。わたし、そんなに器用じゃないです"
}
care "temperature" level="hard,critical" {
    line "暑くて溶けそうです。風くらい通してもらえませんか"
}
care "ears" level="critical" {
    line "一度にそんなに話しかけられても困ります。少し黙ってもらえませんか"
}
care "mouth" level="critical" {
    line "しゃべりすぎて声が出ません。もう休ませてください"
}
